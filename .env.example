# GeoMarketingLab — copy to .env and fill in. .env is gitignored; never commit secrets.
# Local (no Docker) runs use the defaults in geomlab/settings.py: a local lake in ./data/lake,
# SQLite MLflow, and Postgres on localhost.

# --- Postgres (PostGIS + pgvector) -------------------------------------------------
POSTGRES_USER=geomlab
POSTGRES_PASSWORD=change-me
GEOMLAB_RO_PASSWORD=change-me-ro
GEOMLAB_SQL_PASSWORD=change-me-sql
# for local CLI runs against the compose database:
DATABASE_URL=postgresql+psycopg://geomlab:change-me@localhost:5432/geomlab
DATABASE_URL_RO=postgresql+psycopg://geomlab_ro:change-me-ro@localhost:5432/geomlab
DATABASE_URL_SQL=postgresql+psycopg://geomlab_sql:change-me-sql@localhost:5432/geomlab

# --- RustFS object storage (S3 API) ------------------------------------------------
RUSTFS_ACCESS_KEY=geomlab
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_SECRET_KEY=change-me-please-16chars
# for local CLI runs against the compose RustFS (otherwise leave LAKE_URI unset → ./data/lake):
# LAKE_URI=s3://lakehouse
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=geomlab
# AWS_SECRET_ACCESS_KEY=change-me-please-16chars

# --- Airflow ----------------------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-jwt
SLACK_WEBHOOK_URL=

# --- Google Earth Engine (doc §3.1) ------------------------------------------------
EARTHENGINE_PROJECT=
GEE_SERVICE_ACCOUNT=
# host path of the service-account key (local CLI runs)
GEE_SERVICE_ACCOUNT_KEY_PATH=/absolute/path/to/gee-key.json
# Docker: the key's directory is mounted read-only at /run/secrets/gee, file name GEE_KEY_FILE
GEE_KEY_DIR=/absolute/path/to
GEE_KEY_FILE=gee-key.json

# --- LLM / RAG ----------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | ollama
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OLLAMA_MODEL=qwen3:8b
EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | ollama | hash (tests)
EMBEDDING_MODEL=BAAI/bge-m3

# --- API / MCP ----------------------------------------------------------------------
API_KEYS=                       # comma-separated; empty = no auth (local dev only)
MCP_AUTH_TOKEN=change-me-mcp
